<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Zaiets.telegram.bot.framework.dotnet</PackageId>
    <Version>1.0.0</Version>
    <Description>A robust and extensible framework for building Telegram bots in .NET, featuring conversation flow, middleware, and dependency injection support.</Description>
    <PackageTags>telegram bot framework dotnet csharp middleware state-machine commands menus</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- IDE0161: 35 existing files still use block-scoped namespaces; convert to file-scoped in a separate change -->
    <NoWarn>$(NoWarn);CS1573;CS1574;CS1587;CS1591;IDE0161</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="telegram-bot-framework-dotnet.Tests" />
  </ItemGroup>

</Project>
